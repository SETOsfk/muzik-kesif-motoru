# Kopyala: cp .env.ornek .env  — .env git'e girmez. Değerleri kimseyle paylaşma.

# --- Zenginleştirme (yalnız yerel kütüphane hattı) --------------------------
DISCOGS_TOKEN=
MUSICBRAINZ_USER_AGENT=muzik-kesif-motoru/0.1 (iletisim@ornek.com)
# ANTHROPIC_API_KEY=   # opsiyonel — sadece ozetle(mod="api") için

# --- Yayın (docs/yayin.md) --------------------------------------------------
# Sunucunun alan adı; yoksa IP'yle: 203-0-113-7.sslip.io
ALAN_ADI=
# Spotify jetonlarını şifreler. Üret:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KESIF_JETON_ANAHTARI=
# Hesap tavanı (varsayılan 5) ve aynı anda en çok kaç aktarım (her biri ~2 GB bellek).
KESIF_AZAMI_KULLANICI=25
KESIF_ES_ZAMANLI_AKTARIM=2
# Gizlilik sayfasında görünecek iletişim adresi (boş bırakılabilir).
KESIF_ILETISIM=

# --- Spotify (isteğe bağlı; Development Mode en çok 5 davetli hesap) --------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify panelindeki Redirect URI ile birebir aynı olmalı:
# KESIF_SPOTIFY_DONUS=https://ALAN_ADI/giris/spotify/donus
